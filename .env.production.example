# ─────────────────────────────────────────────────────────────────────────────
# OpenOncology — production environment for docker-compose.prod.yml
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# This is NOT .env.example. That one configures the development stack, where
# every value has a working default. Here there are no defaults: compose refuses
# to start with any of the required variables unset, and the API refuses to boot
# on several of them even when they are set to the value shipped as an example.
# That is deliberate — the alternative is a production deployment running on a
# secret that is published in this repository.
#
# NEVER commit .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image version ────────────────────────────────────────────────────────────
# A tag ci.yml published. Use `sha-<short>` or a `v*` release tag; do NOT use
# `latest`. It is mutable, so a container restart can change the running
# version, and this system's output is clinical evidence whose provenance has to
# be answerable.
#
#   docker pull ghcr.io/immortal71/openoncology/api:sha-252d136
IMAGE_TAG=

# ── Public addresses ─────────────────────────────────────────────────────────
# The URLs a browser uses, as seen from outside the reverse proxy. These are not
# cosmetic:
#   PUBLIC_WEB_URL      becomes the API's CORS allow-list. Wrong, and every
#                       request from the site is blocked by the browser.
#   PUBLIC_API_URL      served to the browser at runtime by /env.js.
#   PUBLIC_KEYCLOAK_URL used three times over — Keycloak signs its issuer claim
#                       with it, the API expects that claim, and the browser is
#                       redirected to it to log in. All three must agree or
#                       every authenticated request is a 401.
# No trailing slashes.
PUBLIC_WEB_URL=https://openoncology.example.org
PUBLIC_API_URL=https://api.openoncology.example.org
PUBLIC_KEYCLOAK_URL=https://auth.openoncology.example.org

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each one. Do not reuse a value between two of them.
#   python -c "import secrets; print(secrets.token_hex(32))"      # SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(24))"  # the rest
#
# Losing SECRET_KEY invalidates every session. Losing DB_PASSWORD locks you out
# of the application database, which has no backup unless you configured one —
# see the note at the top of docker-compose.prod.yml.
SECRET_KEY=
DB_PASSWORD=
KC_DB_PASSWORD=
MINIO_ACCESS_KEY=openoncology
MINIO_SECRET_KEY=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_PASSWORD=
FLOWER_USER=admin
FLOWER_PASSWORD=

# ── Keycloak audience ────────────────────────────────────────────────────────
# The value the client's audience mapper emits. The API will not start in
# production without it, because without an audience check a token issued to any
# other client in the realm authenticates against every protected route.
#
# It is not automatic. Keycloak puts the client id in `azp` and "account" in
# `aud` by default; you have to add the mapper. The recipe is step 4.4 of
# docs/RUNBOOK_STAGING_DEPLOY.md, and it is the step people miss.
KEYCLOAK_AUDIENCE=openoncology-api

# ── Error tracking ───────────────────────────────────────────────────────────
# Optional, and the API logs a warning at startup when it is empty: with no DSN
# nothing records an exception in production except the container's stdout.
SENTRY_DSN=

# ── Optional integrations ────────────────────────────────────────────────────
# Each is genuinely optional. The features they power degrade rather than fail.
#
# Without ONCOKB_API_TOKEN the system uses the curated static evidence table,
# which is a supported mode rather than a degraded one — but provenance is
# correctly recorded as not current, so the EvidenceBaseDegraded alert fires.
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
ONCOKB_API_TOKEN=
OPENAI_API_KEY=
