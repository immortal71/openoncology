# ─────────────────────────────────────────────
# OpenOncology — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Variables are read by api/config.py (Settings) unless noted otherwise.
# Lines that start with "# NAME=" are optional: the value shown is the built-in
# default, so uncomment one only to override it. api/tests/test_env_example.py
# fails if a Settings field is missing from this file.

# ── Application ──────────────────────────────
# development and test relax the production hardening checks; any other value
# (production, staging, a typo) requires a real SECRET_KEY, a non-default
# MINIO_SECRET_KEY and KEYCLOAK_AUDIENCE.
ENVIRONMENT=development
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_jwt_secret_min_32_chars
# JSON list of origins allowed by CORS.
# CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Sentry error tracking. Leave empty in development: a DSN with
# ENVIRONMENT=development is rejected as a misconfigured production deploy.
# SENTRY_DSN=

# ── Database ─────────────────────────────────
# docker-compose.yml: password for the PostgreSQL "openoncology" user.
DB_PASSWORD=change_me_strong_password
# SQLAlchemy URL. The default is a local SQLite file; use
# postgresql+asyncpg://openoncology:<DB_PASSWORD>@localhost:5432/openoncology for Postgres.
# DATABASE_URL=sqlite+aiosqlite:///./openoncology_dev.db
# Create tables on startup and seed demo data (development only).
# BOOTSTRAP_SCHEMA_IN_DEV=true
# LOCAL_DEV_SEED_DATA=true

# ── Redis / Celery ───────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 object storage ────────────────
MINIO_ACCESS_KEY=openoncology_admin
# The literal default "password" is rejected outside development/test.
MINIO_SECRET_KEY=change_me_minio_secret
# MINIO_ENDPOINT=localhost:9000
# MINIO_SECURE=false
# BUCKET_RAW=openoncology-raw
# BUCKET_VCF=openoncology-vcf
# BUCKET_REPORTS=openoncology-reports
# Where uploads go when ENVIRONMENT=development and MinIO is unreachable.
# LOCAL_STORAGE_DIR=./local_storage

# ── Keycloak ─────────────────────────────────
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=openoncology
# KEYCLOAK_CLIENT_ID=openoncology-api
# KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# Expected `aud` claim on incoming tokens. Leave empty for a local realm; the
# API refuses to boot with ENVIRONMENT=production while it is empty, because
# without it a token issued to any other client in the realm authenticates
# against every protected route.
#
# Keycloak does not put the client id in `aud` by default — it goes in `azp` and
# `aud` is "account". Setting this means adding an audience mapper to the
# client and using the value that mapper emits.
KEYCLOAK_AUDIENCE=

# Expected `iss` claim. Empty derives it from KEYCLOAK_URL and the realm. Set it
# where the address the API dials differs from the hostname Keycloak signs with,
# which is the usual case in a cluster: the API reaches the internal Service
# while tokens carry the public ingress hostname.
KEYCLOAK_ISSUER=

# How long a fetched JWKS is reused, and the timeout for fetching it.
# KEYCLOAK_JWKS_CACHE_SECONDS=300
# KEYCLOAK_JWKS_TIMEOUT_SECONDS=5.0

# ── Evidence and ranking policy ──────────────
# OncoKB (free academic token — apply at oncokb.org). Without it the actionability
# table falls back to the undated built-in static set.
ONCOKB_API_TOKEN=
# Separate token for the OncoKB public dump download; defaults to ONCOKB_API_TOKEN.
# ONCOKB_PUBLIC_DUMP_TOKEN=
# Withhold recommendations (not just flag them) when the evidence table is the
# undated static fallback. Must be true for any clinical deployment.
# REQUIRE_CURRENT_EVIDENCE=false
# Merge CIViC level A/B predictive evidence into the actionability table,
# capped at LEVEL_3B and never overriding OncoKB.
# CIVIC_SUPPLEMENT_ENABLED=false
# Which candidates are ranked: "evidence_first" (table answer replaces the pool
# where it has one) or "tier2" (rank the whole repurposing pool).
# CANDIDATE_POOL_POLICY=evidence_first
# Consecutive static-fallback resolutions before the log escalates to ERROR.
# DEGRADED_EVIDENCE_ALERT_AFTER=3

# ── Integrations ─────────────────────────────
# OpenAI (plain-language LLM summaries — optional, falls back to template)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Stripe (crowdfunding / payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Read by the Next.js frontend (web/), so set it in web/.env.local as well.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# COSMIC (somatic mutation catalogue — free academic registration at cancer.sanger.ac.uk)
COSMIC_EMAIL=
COSMIC_PASSWORD=

# ── Observability (docker-compose.yml) ───────
GRAFANA_PASSWORD=change_me_grafana
# Celery Flower basic-auth credentials.
# FLOWER_USER=admin
# FLOWER_PASSWORD=changeme

# Set to 1 to run SigProfilerAssignment for mutational signatures (must be installed).
# SIGPROFILER_ENABLED=0

# ── AI pipeline (read directly from the environment by ai/) ──
# Bearer token for AlphaFold Server; structure generation also works without it
# but is rate limited.
# ALPHAFOLD_API_KEY=
# Bucket where generated AlphaFold structures are stored.
# ALPHAFOLD_STRUCTURE_BUCKET=openoncology-vcf
# DiffDock checkout and the Python interpreter used to run it.
# DIFFDOCK_DIR=ai/diffdock/DiffDock
# DIFFDOCK_PYTHON=python
