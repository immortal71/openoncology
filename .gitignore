# ── Benchmark / validation run outputs (regenerated by scripts/*, not source) ──
# These are written to the repo root by the benchmark scripts. Curated,
# README-linked artifacts are kept under validation_results/ instead.
/real_patient_benchmark*.json
/r120*.json
/benchmark_results.json
/hard_benchmark_results.json
/industry_validation_report.json
/p3_stability_report.json
/validation_report_with_real_diffdock*.json
/diffdock_rescoring_inputs.json
/blind_review_*.json
/demo_output.json

# Dev scratch / temp files (should never be committed)
/layout_css*.txt
/sample?_biopsy.txt
/sample?_dna.vcf
web/response.json
web/tmp_*.txt
web/tsconfig.tsbuildinfo
api/temp_requirements*.txt

# Frontend test outputs
web/coverage/
web/playwright-report/
web/test-results/
web/.playwright/

# Downloaded patient cohorts (regenerated, not source). scripts/fetch_real_patients.py
# and scripts/download_real_data.py pull these from cBioPortal; a full fetch drops
# several hundred files into samples/real/ and buries every `git status`. The
# fixture subset the test suite pins is already tracked, and git keeps honouring
# tracked paths, so this rule only silences newly downloaded ones. To commit a new
# fixture deliberately: `git add -f samples/real/<file>`.
samples/real/*.vcf
samples/real/*.txt

# Cell-line validation run outputs (regenerated by
# scripts/validate_cell_line_drug_response.py from CCLE/GDSC2 source tables)
validation_results/cache/*.tsv
validation_results/cell_line_drug_response.json

# Bulk source archives pulled by the validation gate scripts (ClinVar
# variant_summary is 442 MB, AlphaMissense substitutions is 1.2 GB). The small
# filtered extracts next to them ARE committed, so --offline reruns need no
# network. Re-fetch with scripts/validate_alphamissense_clinvar.py.
validation_results/cache/*.gz

# Coverage run artefacts (regenerated by pytest --cov)
.coverage
.coverage.*
coverage.xml
