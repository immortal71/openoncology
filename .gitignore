web/tmp_*.txt
web/tsconfig.tsbuildinfo
api/temp_requirements*.txt

# Frontend test outputs
web/coverage/
web/playwright-report/
web/test-results/
web/.playwright/

# Downloaded patient cohorts (regenerated, not source). scripts/fetch_real_patients.py
# and scripts/download_real_data.py pull these from cBioPortal; a full fetch drops
# several hundred files into samples/real/ and buries every `git status`. The
# fixture subset the test suite pins is already tracked, and git keeps honouring
# tracked paths, so this rule only silences newly downloaded ones. To commit a new
# fixture deliberately: `git add -f samples/real/<file>`.
samples/real/*.vcf
samples/real/*.txt

# Coverage run artefacts (regenerated by pytest --cov)
.coverage
.coverage.*
coverage.xml

# Everything under validation_results/cache/ is a re-downloadable extract rather
# than source: GIAB HG002 truth sets (342 MB), ClinVar variant_summary (442 MB),
# AlphaMissense substitutions (1.2 GB), and the CCLE and GDSC2 tables. Re-fetch
# by running the matching script in scripts/; each downloads on first use unless
# --offline is passed.
#
# Two small filtered extracts are deliberate exceptions and stay committed, so
# --offline reruns of validate_alphamissense_clinvar.py need no network:
#   validation_results/cache/alphamissense_brca.tsv
#   validation_results/cache/clinvar_brca_missense.tsv
# A gitignore rule does not untrack files, so those two are unaffected by this.
#
# Results and reports written to validation_results/ itself ARE tracked. They are
# the record of what the pipeline scored, and the README links to several.
validation_results/cache/

.claude/
loop.ps1
